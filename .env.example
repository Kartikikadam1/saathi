# Copy to .env (or set in your host's dashboard). Everything is optional — without a key the agent runs on its rule engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Real Telegram alerts to family (optional): create a bot with @BotFather, then add each contact's chat ID in Patient setup.
TELEGRAM_BOT_TOKEN=
APP_TIMEZONE=Asia/Kolkata
# Demo-friendly call timing (production would be minutes)
RING_TIMEOUT_S=25
RETRY_INTERVAL_S=15
MAX_RETRIES=2
# Read caregiver records over HTTP from another dashboard exposing the same API (blank = built-in mock dashboard)
CAREGIVER_API_BASE=
